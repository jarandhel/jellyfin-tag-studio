# Normalise to LF in the repository, check out native on Windows.
* text=auto

*.cs      text diff=csharp
*.ts      text
*.tsx     text
*.css     text
*.html    text
*.json    text
*.md      text
*.ps1     text eol=crlf
# CRLF in a shell script breaks the shebang on Linux.
*.sh      text eol=lf
*.csproj  text

*.png binary
*.jpg binary
*.webp binary
*.dll binary
